# Local development defaults to data/catches.sqlite3 when this is omitted.
# REEF_DATABASE_URL=postgresql://reef_user:replace_me@127.0.0.1:5432/reef_catch
REEF_DATA_DIR=./data

# Deployment examples (do not commit real credentials):
# REEF_DATABASE_URL=postgresql://reef_user:strong_password@127.0.0.1:5432/reef_catch

# Password recovery email (recommended for deployment):
# REEF_SMTP_HOST=smtp.example.org
# REEF_SMTP_PORT=587
# REEF_SMTP_USER=mailer@example.org
# REEF_SMTP_PASSWORD=replace_me
# REEF_SMTP_FROM=Reef Catch Monitor <mailer@example.org>
# REEF_RESET_BASE_URL=https://catch.example.org

# Local development only: return a reset token in the API response.
# Never enable this in production.
# REEF_DEV_SHOW_RESET_TOKEN=1
